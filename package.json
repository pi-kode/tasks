{
  "name": "@pi-kode/tasks",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "description": "Standalone pi extension: tasks, todo checklist UI, and background jobs",
  "files": [
    "index.ts",
    "lib",
    "tests",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "typebox": "1.3.27"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-kode/tasks.git"
  },
  "homepage": "https://github.com/pi-kode/tasks#readme",
  "bugs": "https://github.com/pi-kode/tasks/issues",
  "publishConfig": {
    "access": "public"
  }
}
